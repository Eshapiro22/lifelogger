{
  "manifest_version": 3,
  "name": "Call Copilot",
  "version": "0.2.0",
  "description": "Side-panel call track for power dialing: rotating openers, problem propositions, and objection handling.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Call Copilot"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
