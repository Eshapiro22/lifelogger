{
  "manifest_version": 3,
  "name": "Triple Touch Email Writer",
  "version": "0.3.0",
  "description": "Writes subject lines and bodies for each email step of an outbound sequence, following 30MPC's Triple Touch and Untap Your Sales Potential.",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*", "https://*.outreach.io/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Triple Touch Email Writer" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
