{
  "manifest_version": 3,
  "name": "30MPC Email Writer",
  "version": "0.1.0",
  "description": "Writes subject lines and bodies for each email step of an outbound sequence, following 30 Minutes to President's Club principles.",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open 30MPC Email Writer" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
