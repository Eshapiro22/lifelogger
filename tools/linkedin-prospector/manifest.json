{
  "manifest_version": 3,
  "name": "LinkedIn Prospector",
  "version": "0.4.0",
  "description": "Matches recent LinkedIn connections to your account list, checks prior contact, and drafts Triple T messages for you to send by hand.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Prospector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://outlook.live.com/*"
      ],
      "js": [
        "lib/util.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
